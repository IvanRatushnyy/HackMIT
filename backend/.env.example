# Copy to backend/.env. Fixture mode needs nothing here.
ELUTE_MODE=live
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5
# With no key, recorded OpenAI outputs are replayed by prompt hash (an output is reused only when the prompt is identical):
ELUTE_LLM_CASSETTES=tests/fixtures/llm
# Completed live runs are written here for the browser's sped-up replay (gitignored). Default: <repo>/public/demo
# ELUTE_DEMO_DIR=../public/demo
# ELUTE_CORS_ORIGINS=http://localhost:5173
# ELUTE_DEMO_DISABLE_TOOL=literature
